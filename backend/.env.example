# Template for backend/.env. Copy it, then fill in the blanks:
#   Copy-Item backend\.env.example backend\.env
# backend/.env is git-ignored, so real secrets never reach GitHub. This file is committed
# so anyone cloning the repo knows exactly which variables the backend expects.

# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Where the React app runs. Used for CORS and for redirecting the browser after login.
FRONTEND_URL=http://localhost:5173

# ---------- Infrastructure (must match docker-compose.yml) ----------
# 127.0.0.1 instead of "localhost": on Windows, localhost can resolve to IPv6 (::1) first,
# but the Docker ports are published on IPv4 only.
DATABASE_URL=postgresql://scheduler:scheduler_dev@127.0.0.1:5432/email_scheduler
REDIS_URL=redis://127.0.0.1:6379
ELASTICSEARCH_URL=http://127.0.0.1:9200

# ---------- Auth ----------
# Signs the JWTs our API hands to the frontend. Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Cloud Console -> Google Auth Platform -> Clients -> your Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that client exactly (scheme, host, port, path).
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------- Slack ----------
# api.slack.com/apps -> your app -> Basic Information -> App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack only redirects to HTTPS URLs, so this goes through your ngrok domain, which
# forwards to http://localhost:PORT. Must match the Redirect URL saved in the Slack app.
SLACK_REDIRECT_URI=https://YOUR-NGROK-DOMAIN/api/integrations/slack/callback

# ---------- Throughput (used from Phase 3) ----------
# How many jobs one worker process handles at the same time.
WORKER_CONCURRENCY=5
# Minimum gap between two sends, enforced across all workers by BullMQ's limiter.
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender per clock hour. Overflow is moved to the next hour, never dropped.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
